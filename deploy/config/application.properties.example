# 서버 실물: /home/ubuntu/cbu/config/application.properties (backend 컨테이너에 /app/config 로 ro 마운트)
# 이 파일은 키 목록만 있는 템플릿. 실제 값은 서버에만 있다 → scripts/fetch-server-files.sh 로 받을 것.
# git 에 올리지 않는다 (.gitignore 에 이미 있음).

spring.application.name=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
# DB = 같은 서버의 mysql 컨테이너 (cbu-net 네트워크, 호스트명 mysql). 구 RDS 아님.
spring.datasource.url=jdbc:mysql://mysql:3306/CbuManage?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=cbu_app
spring.datasource.password=<서버에서>

spring.jpa.properties.hibernate.show_sql=
spring.jpa.properties.hibernate.format_sql=
spring.jpa.hibernate.ddl-auto=validate      # 스키마는 deploy/sql 마이그레이션으로만 바꾼다

google.spreadSheet.key=<서버에서>
google.spreadSheetEdit.key=<서버에서>
google.spreadSheet.id=<서버에서>
google.successSpreadSheet.id=<서버에서>

default.login.password=<서버에서>           # 관리자가 만든 회원의 초기 비밀번호

spring.mail.host=smtp.gmail.com
spring.mail.port=465
spring.mail.username=<서버에서>             # 인증메일 발신 계정
spring.mail.password=<서버에서>             # 앱 비밀번호
spring.mail.properties.mail.smtp.auth=true
spring.mail.protocol=smtp
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.ssl.enable=true
spring.mail.properties.mail.smtp.timeout=
spring.mail.properties.mail.smtp.connectiontimeout=
spring.mail.properties.mail.smtp.writetimeout=

spring.data.redis.host=redis                 # compose 의 redis 컨테이너
spring.data.redis.port=6379

cbu.jwt.secret=<서버에서>                    # ⚠️ 과거 채팅에 노출된 이력 있음 → 교체 검토 (교체 시 전원 재로그인)
cbu.jwt.expireTime=600000                    # access 10분
cbu.jwt.refreshExpireTime=864000000          # refresh 10일
cbu.jwt.interceptor=true
cbu.jwt.secureCookie=false
cbu.jwt.sameSite=Lax
cbu.login.salt=<서버에서>

aws.access.key.id=<서버에서>                 # S3 업로드용 IAM 키
aws.secret.access.key=<서버에서>
aws.region.static=ap-northeast-2
aws_bucket=cbumanages3bucket
spring.autoconfigure.exclude=
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# 쿠키 인증 CORS 허용 origin (쉼표 구분). FE 도메인 바뀌면 여기.
cbu.cors.allowed-origins=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://www.tukcbu.com,https://tukcbu.com

server.forward-headers-strategy=framework
cbu.proxy.secret=<서버에서>                  # FE(Vercel) 환경변수 PROXY_SECRET 과 같은 값이어야 함
