# 서버 실물: /home/ubuntu/cbu/nginx/default.conf (nginx 컨테이너에 /etc/nginx/conf.d 로 ro 마운트)
server {
    listen 80;
    server_name dev.tukcbu.com;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name dev.tukcbu.com;

    ssl_certificate /etc/letsencrypt/live/dev.tukcbu.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.tukcbu.com/privkey.pem;
    client_max_body_size 25m;

    location /api/v1/ {
        proxy_pass http://backend:8080/api/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin $http_origin;
    }
    location /swagger-ui/ {
        proxy_pass http://backend:8080/swagger-ui/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /v3/api-docs {
        rewrite ^/v3/api-docs/$ /v3/api-docs break;
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / { return 404 "Frontend is disabled."; }
}
